                   RowBox[{
                    RowBox[{"y2", "[", "t", "]"}], "-", 
                    RowBox[{"y3", "[", "t", "]"}]}], ")"}], "^", "2"}], "+", 
                 RowBox[{"epsilon", "^", "2"}]}], ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"3", "/", "2"}], ")"}]}]}]}]}]}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Initial", " ", "conditions"}], "*)"}], 
       RowBox[{"init", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"x1", "[", "0", "]"}], "==", 
           RowBox[{"pos1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"y1", "[", "0", "]"}], "==", 
           RowBox[{"pos1", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"x2", "[", "0", "]"}], "==", 
           RowBox[{"pos2", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"y2", "[", "0", "]"}], "==", 
           RowBox[{"pos2", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"x3", "[", "0", "]"}], "==", 
           RowBox[{"pos3", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"y3", "[", "0", "]"}], "==", 
           RowBox[{"pos3", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"x1", "'"}], "[", "0", "]"}], "==", 
           RowBox[{"vel1", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"y1", "'"}], "[", "0", "]"}], "==", 
           RowBox[{"vel1", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"x2", "'"}], "[", "0", "]"}], "==", 
           RowBox[{"vel2", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"y2", "'"}], "[", "0", "]"}], "==", 
           RowBox[{"vel2", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"x3", "'"}], "[", "0", "]"}], "==", 
           RowBox[{"vel3", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"y3", "'"}], "[", "0", "]"}], "==", 
           RowBox[{"vel3", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Solve", " ", "the", " ", "system"}], "*)"}], 
       RowBox[{"sol", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"NDSolve", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"eqs", ",", "init"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
            "x1", ",", "y1", ",", "x2", ",", "y2", ",", "x3", ",", "y3"}], 
            "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
           RowBox[{"MaxSteps", "->", "1000000"}], ",", 
           RowBox[{"Method", "->", "\"\<StiffnessSwitching\>\""}], ",", 
           RowBox[{"PrecisionGoal", "->", "8"}], ",", 
           RowBox[{"AccuracyGoal", "->", "8"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"If", " ", "solution", " ", "failed"}], ",", 
         RowBox[{"return", " ", "empty", " ", "list"}]}], "*)"}], 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"sol", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Check", " ", "for", " ", "escapes", " ", "or", " ", "extreme", " ", 
         "behavior"}], "*)"}], 
       RowBox[{"maxDist", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"x1", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"y1", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
                "]"}], "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"x2", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"y2", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
                "]"}], "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"x3", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"y3", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
                "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "80", ",", "100", ",", "2"}], "}"}]}], "]"}],
             "]"}], ",", "Infinity"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"maxDist", ">", "500"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"System", " ", "escaped"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
        "Get", " ", "local", " ", "maxima", " ", "of", " ", "x1", " ", 
         "position"}], "*)"}], 
       RowBox[{"maxima", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"getLocalMaxima", "[", 
            RowBox[{"sol", ",", "80", ",", "100"}], "]"}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "maxima", "]"}], "==", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Filter", " ", "extreme", " ", "values"}], "*)"}], 
       RowBox[{"maxima", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"maxima", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "200"}], "<=", "#", "<=", "200"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Return", " ", "points", " ", "for", " ", "bifurcation", " ", 
         "diagram"}], "*)"}], 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"mVar", ",", "max"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"max", ",", "maxima"}], "}"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "bifurcation", " ", "data", " ", "by", " ", "varying", 
     " ", "m1"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mRange", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "10", ",", "0.001"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "m1", " ", "from", " ", "1", " ", "to", " ", "10", " ", "in", " ", 
     "steps", " ", "of", " ", "0.05"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"bifurcationData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Generating bifurcation diagram...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Varying m1 from \>\"", ",", 
      RowBox[{"First", "[", "mRange", "]"}], ",", "\"\< to \>\"", ",", 
      RowBox[{"Last", "[", "mRange", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Using seed: \>\"", ",", "seed"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total parameter values: \>\"", ",", 
      RowBox[{"Length", "[", "mRange", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"progress", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "=", 
          RowBox[{"runSimulation", "[", "mVar", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "data", "]"}], ">", "0"}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"bifurcationData", ",", "data"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"progress", "++"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"mVar", ",", "mRange"}], "}"}]}], "]"}], ",", 
      RowBox[{"ProgressIndicator", "[", 
       RowBox[{"progress", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"Length", "[", "mRange", "]"}]}], "}"}]}], "]"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Flatten", " ", "the", " ", "data"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"flatData", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"bifurcationData", ",", "1"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nTotal points: \>\"", ",", 
      RowBox[{"Length", "[", "flatData", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "the", " ", "bifurcation", " ", "diagram"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"bifurcationPlot", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"PointSize", "[", "0.0003", "]"}], ",", "Blue", ",", 
         RowBox[{"Point", "[", "flatData", "]"}]}], "}"}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", 
          RowBox[{"Thickness", "[", "0.002", "]"}], ",", 
          RowBox[{"FontSize", "->", "12"}]}], "]"}]}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<\\!\\(\\*SubscriptBox[\\(m\\), \\(1\\)]\\) (au)\>\"", ",", 
            RowBox[{"FontSize", "->", "14"}], ",", " ", "Italic"}], "]"}], 
          ",", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<\\!\\(\\*SubscriptBox[\\(x\\), \\(1\\)]\\) (au)\>\"", ",", 
            RowBox[{"FontSize", "->", "14"}], ",", " ", "Italic"}], "]"}]}], 
         "}"}]}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "10"}], "}"}], ",", "Automatic"}], "}"}]}], ",", 
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<\\n=== Bifurcation Diagram (Local Maxima Method) ===\>\"", "]"}], 
    ";"}], "\n", "bifurcationPlot", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Optional", ":", 
     RowBox[{
