   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Constants", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"G", "=", 
     RowBox[{"4", " ", 
      RowBox[{"Pi", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"conv", "=", 
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"1.496*^8", "*", "365.25", "*", "24", "*", "3600"}], ")"}]}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"seed", "=", "105"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"epsilon", "=", "0.01"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Softening", " ", "parameter"}], "*)"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
