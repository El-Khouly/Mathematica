                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"y1", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
                "]"}], "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"x2", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"y2", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
                "]"}], "+", 
               RowBox[{"Sqrt", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"x3", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"y3", "[", "t", "]"}], "/.", " ", 
                    RowBox[{"sol", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "^", "2"}]}], 
                "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", "80", ",", "100", ",", "2"}], "}"}]}], "]"}],
             "]"}], ",", "Infinity"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"maxDist", ">", "500"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", 
       RowBox[{"(*", 
        RowBox[{"System", " ", "escaped"}], "*)"}], 
       RowBox[{"(*", 
        RowBox[{
        "Get", " ", "local", " ", "maxima", " ", "of", " ", "x1", " ", 
         "position"}], "*)"}], 
       RowBox[{"maxima", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"getLocalMaxima", "[", 
            RowBox[{"sol", ",", "80", ",", "100"}], "]"}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "maxima", "]"}], "==", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Filter", " ", "extreme", " ", "values"}], "*)"}], 
       RowBox[{"maxima", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"maxima", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "200"}], "<=", "#", "<=", "200"}], "&"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Return", " ", "points", " ", "for", " ", "bifurcation", " ", 
         "diagram"}], "*)"}], 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"mVar", ",", "max"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"max", ",", "maxima"}], "}"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "bifurcation", " ", "data", " ", "by", " ", "varying", 
     " ", "m1"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"mRange", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", "10", ",", "0.001"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "m1", " ", "from", " ", "1", " ", "to", " ", "10", " ", "in", " ", 
     "steps", " ", "of", " ", "0.05"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"bifurcationData", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Generating bifurcation diagram...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Varying m1 from \>\"", ",", 
      RowBox[{"First", "[", "mRange", "]"}], ",", "\"\< to \>\"", ",", 
      RowBox[{"Last", "[", "mRange", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Using seed: \>\"", ",", "seed"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total parameter values: \>\"", ",", 
      RowBox[{"Length", "[", "mRange", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"progress", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Monitor", "[", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"data", "=", 
          RowBox[{"runSimulation", "[", "mVar", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "data", "]"}], ">", "0"}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"bifurcationData", ",", "data"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"progress", "++"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"mVar", ",", "mRange"}], "}"}]}], "]"}], ",", 
      RowBox[{"ProgressIndicator", "[", 
       RowBox[{"progress", ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"Length", "[", "mRange", "]"}]}], "}"}]}], "]"}]}], "]"}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Flatten", " ", "the", " ", "data"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"flatData", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"bifurcationData", ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nTotal points: \>\"", ",", 
      RowBox[{"Length", "[", "flatData", "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "the", " ", "bifurcation", " ", "diagram"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bifurcationPlot", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
