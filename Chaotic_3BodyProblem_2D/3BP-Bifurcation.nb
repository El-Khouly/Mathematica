          ",", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<\\!\\(\\*SubscriptBox[\\(x\\), \\(1\\)]\\) (au)\>\"", ",", 
            RowBox[{"FontSize", "->", "14"}], ",", " ", "Italic"}], "]"}]}], 
