      "ListPlot"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"listPlotVersion", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"flatData", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
