           RowBox[{
           "\"\<\!\(\*SubscriptBox[\(x\), \(\(1\)\(\\\ \)\)]\)(au)\>\"", ",", 
            "Italic", ",", 
            RowBox[{"FontSize", "->", "14"}]}], "]"}]}], "}"}]}], ",", 
       RowBox[{"GridLines", "->", "Automatic"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "10"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"100", ",", 
            RowBox[{"-", "100"}]}], "}"}]}], "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"inverted", " ", "y"}], "-", "axis"}], "*)"}], 
       RowBox[{"AspectRatio", "->", 
        RowBox[{"1", "/", "2"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}], ",", 
       RowBox[{"Joined", "->", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
