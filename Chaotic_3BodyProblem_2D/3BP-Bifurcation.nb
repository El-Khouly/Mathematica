   RowBox[{
    RowBox[{"getLocalMaxima", "[", 
     RowBox[{"sol_", ",", "tStart_", ",", "tEnd_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x1Func", ",", "samples", ",", "peaks"}], "}"}], ",", 
      RowBox[{
       RowBox[{"x1Func", "=", 
