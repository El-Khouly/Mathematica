Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<S-box Metric Guidance (definitions & desirable directions):\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<  nonLin -> Higher is better (resists linear attacks).\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<             Theoretical max nonLinearity = 12.\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<  SAC    -> Ideal = 0.5 (avalanche). Values near 0.5 are desirable.\
\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<  BIC    -> (mean |corr| between output bits) : Lower is better (0 \
= perfect independence).\>\"", "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<  LAP    -> Lower is better. (LAP = max |LAT| / 2^n, normalized; \
smaller bias is better).\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", 
     "\"\<  DAP    -> Lower is better. (DAP = max entry of the DDT / 2^n, \
probability; smaller is better).\>\"", "]"}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9707244737061243`*^9, 3.9707244753179784`*^9}, 
   3.970724506315725*^9, {3.9707245368484983`*^9, 3.9707245773747478`*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"bf82b14e-df8b-4573-817c-3cde2e3006d6"],

