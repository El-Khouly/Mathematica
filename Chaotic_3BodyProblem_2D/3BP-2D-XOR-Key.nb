In[99]:=",ExpressionUUID->"95d287e1-4e9f-4541-ad2b-b45d308b2a77"],

Cell[BoxData["\<\"  nonLin -> Higher is better (resists linear \
attacks).\"\>"], "Print",
 CellChangeTimes->{3.9707244765185304`*^9, 3.9707245073417745`*^9, 
  3.9707245780694733`*^9, 3.9707263424447327`*^9, 3.975516552347431*^9},
 CellLabel->
  "During evaluation of \
In[99]:=",ExpressionUUID->"3f3f24cf-c011-4f2e-a15d-610b71e84125"],

Cell[BoxData["\<\"             Theoretical max nonLinearity = 12.\"\>"], \
"Print",
 CellChangeTimes->{3.9707244765185304`*^9, 3.9707245073417745`*^9, 
  3.9707245780694733`*^9, 3.9707263424447327`*^9, 3.9755165523526225`*^9},
