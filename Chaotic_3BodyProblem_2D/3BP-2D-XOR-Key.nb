Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"1", ")"}], " ", "Generate", " ", "S"}], "-", "boxes"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"asconSBoxes", "=", 
     RowBox[{"GenerateSBoxesFromStream", "[", 
      RowBox[{"key", ",", "32", ",", "1000"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"2", ")"}], " ", "Evaluate", " ", "each", " ", "S"}], "-", 
     "box"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rawEvals", "=", 
     RowBox[{"EvalSbox2", "/@", "asconSBoxes"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"3", ")"}], " ", 
      RowBox[{"Normalize", ":", 
       RowBox[{
       "convert", " ", "list", " ", "of", " ", "rules", " ", "with", " ", 
        "string", " ", "values"}]}]}], "->", 
     RowBox[{"Association", " ", "with", " ", "numeric", " ", "values"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"normalizeEval", "[", "eval_", "]"}], ":=", 
     RowBox[{"Association", "@", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"k", ",", "v"}], "}"}], ",", 
          RowBox[{
           RowBox[{"ToString", "[", "k", "]"}], "->", 
           RowBox[{"Quiet", "@", 
            RowBox[{"Check", "[", 
             RowBox[{
              RowBox[{"ToExpression", "[", "v", "]"}], ",", "v"}], 
             "]"}]}]}]}], "]"}], ",", 
        RowBox[{"Association", "[", "eval", "]"}]}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"numericEvals", "=", 
     RowBox[{"normalizeEval", "/@", "rawEvals"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"4", ")"}], " ", "Pair", " ", "S"}], "-", 
     RowBox[{"box", " ", "with", " ", "its", " ", "evaluation"}]}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"paired", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<SBox\>\"", "->", "#1"}], ",", 
          RowBox[{"\"\<Eval\>\"", "->", "#2"}]}], "|>"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"asconSBoxes", ",", "numericEvals"}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"5", ")"}], " ", "Filter", " ", "by", " ", "multiple", " ", 
     "conditions"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"good", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"paired", ",", 
       RowBox[{"Function", "[", 
        RowBox[{"p", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"e", "=", 
             RowBox[{"p", "[", "\"\<Eval\>\"", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"e", "[", "\"\<nonLin\>\"", "]"}], ">", "8"}], "&&", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"e", "[", "\"\<SAC\>\"", "]"}], ">=", "0.45"}], "&&", 
            RowBox[{
             RowBox[{"e", "[", "\"\<SAC\>\"", "]"}], "<=", "0.55"}], "&&", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"e", "[", "\"\<BIC\>\"", "]"}], ">=", "0.0"}], "&&", 
            RowBox[{
             RowBox[{"e", "[", "\"\<BIC\>\"", "]"}], "<=", "0.5"}], "&&", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"e", "[", "\"\<LAP\>\"", "]"}], "<=", "0.25"}], "&&", 
            RowBox[{
             RowBox[{"e", "[", "\"\<DAP\>\"", "]"}], "<=", "0.25"}]}]}], " ", 
          "]"}]}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"6", ")"}], " ", "Output", " ", "results"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Strong S-boxes found: \>\"", ",", 
      RowBox[{"Length", "[", "good", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"\"\<S-box \>\"", ",", "i", ",", "\"\<: \>\"", ",", 
        RowBox[{"good", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "\"\<SBox\>\""}], "]"}], "]"}], ",", 
        "\"\<  nonLin = \>\"", ",", 
        RowBox[{"good", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "\"\<Eval\>\"", ",", "\"\<nonLin\>\""}], "]"}], 
         "]"}], ",", "\"\<  SAC = \>\"", ",", 
        RowBox[{"good", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "\"\<Eval\>\"", ",", "\"\<SAC\>\""}], "]"}], 
         "]"}], ",", "\"\<  BIC = \>\"", ",", 
        RowBox[{"good", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "\"\<Eval\>\"", ",", "\"\<BIC\>\""}], "]"}], 
         "]"}], ",", "\"\<  LAP = \>\"", ",", 
        RowBox[{"good", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "\"\<Eval\>\"", ",", "\"\<LAP\>\""}], "]"}], 
         "]"}], ",", "\"\<  DAP = \>\"", ",", 
        RowBox[{"good", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "\"\<Eval\>\"", ",", "\"\<DAP\>\""}], "]"}], 
         "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "good", "]"}]}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9707286546750946`*^9, 3.970728654933266*^9}, 
