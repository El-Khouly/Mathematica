Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"observable", ":", 
     RowBox[{
     "a", " ", "coordinate", " ", "from", " ", "the", " ", "integrated", " ", 
      "trajectory"}]}], ",", 
    RowBox[{"NOT", " ", "the", " ", "keystream"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"traj", "=", "x2Series"}], ";"}], "                      ", 
   RowBox[{"(*", 
    RowBox[{"substitute", " ", "your", " ", "trajectory", " ", "variable"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"xs", "=", 
     RowBox[{"Standardize", "[", 
      RowBox[{"Take", "[", 
       RowBox[{"traj", ",", 
        RowBox[{"{", 
         RowBox[{"2001", ",", 
          RowBox[{"2001", "+", "4999"}]}], "}"}]}], "]"}], "]"}]}], ";"}], 
   "   ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"drop", " ", "transient"}], ",", 
     RowBox[{"5000", " ", "pts"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"K01", "[", 
     RowBox[{"x_List", ",", "c_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "p", ",", "q", ",", "mu", ",", "nMax", ",", "M", ",", "Dc"}],
        "}"}], ",", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"Accumulate", "[", 
         RowBox[{"x", "*", 
          RowBox[{"Cos", "[", 
           RowBox[{"c", "*", 
            RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"Accumulate", "[", 
         RowBox[{"x", "*", 
          RowBox[{"Sin", "[", 
           RowBox[{"c", "*", 
            RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mu", "=", 
        RowBox[{"Mean", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nMax", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"n", "/", "10"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"M", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Mean", "[", 
