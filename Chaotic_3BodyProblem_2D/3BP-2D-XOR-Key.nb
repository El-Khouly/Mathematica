Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"0", "-", 
     RowBox[{"1", " ", "test", " ", "for", " ", "chaos"}]}], ",", 
    RowBox[{"Gottwald", "-", "Melbourne"}], ",", 
    RowBox[{
     RowBox[{"modified", " ", "mean"}], "-", 
     RowBox[{"square", " ", "displacement"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"K01", "[", 
     RowBox[{"x_List", ",", "c_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "len", ",", "p", ",", "q", ",", "phiMean", ",", "nMax", ",", "M", ",", 
        "Dc", ",", "nn"}], "}"}], ",", 
      RowBox[{
       RowBox[{"len", "=", 
        RowBox[{"Length", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"p", "=", 
        RowBox[{"Accumulate", "[", 
         RowBox[{"x", " ", 
          RowBox[{"Cos", "[", 
           RowBox[{
            RowBox[{"Range", "[", "len", "]"}], " ", "c"}], "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"Accumulate", "[", 
         RowBox[{"x", " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"Range", "[", "len", "]"}], " ", "c"}], "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"phiMean", "=", 
        RowBox[{"Mean", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nMax", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"len", "/", "10"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"regression", " ", 
         RowBox[{"range", ":", 
          RowBox[{"n", " ", "up", " ", "to", " ", 
           RowBox[{"N", "/", "10"}]}]}]}], "*)"}], 
       RowBox[{"M", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"p", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", "+", "n"}], "]"}], "]"}], "-", 
                 RowBox[{"p", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"q", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", "+", "n"}], "]"}], "]"}], "-", 
                 RowBox[{"q", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "^", "2"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"len", "-", "n"}]}], "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"subtract", " ", "the", " ", "oscillatory", " ", 
         RowBox[{"term", "--"}], " ", "without", " ", "this", " ", "K", " ", 
         "is", " ", "biased"}], "*)"}], 
       RowBox[{"Dc", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"M", "[", 
            RowBox[{"[", "n", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"phiMean", "^", "2"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"Cos", "[", 
                RowBox[{"n", " ", "c"}], "]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"Cos", "[", "c", "]"}]}], ")"}]}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"n", ",", "1", ",", "nMax"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"nn", "=", 
        RowBox[{"Range", "[", "nMax", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Correlation", "[", 
        RowBox[{
         RowBox[{"N", "[", "nn", "]"}], ",", "Dc"}], "]"}]}]}], "]"}]}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"one", " ", "c", " ", "is", " ", "not", " ", 
     RowBox[{"enough", ":", 
      RowBox[{"individual", " ", "values", " ", "hit", " ", 
       RowBox[{"resonances", ".", "Take"}], " ", "the", " ", 
       RowBox[{"median", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cs", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "5"}], ",", 
         RowBox[{"4", " ", 
          RowBox[{"Pi", "/", "5"}]}]}], "}"}], ",", "100"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Ks", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"K01", "[", 
        RowBox[{"x", ",", "#"}], "]"}], "&"}], "/@", "cs"}]}], ";"}], "\n", 
   RowBox[{"K", "=", 
    RowBox[{"Median", "[", "Ks", "]"}]}], "\n", 
   RowBox[{"Histogram", "[", 
    RowBox[{"Ks", ",", "Automatic", ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<median K = \>\"", ",", "K"}], "}"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{3.995887328182727*^9},
 CellLabel->
  "In[116]:=",ExpressionUUID->"2ce0cf97-e725-425b-ba98-2ce52eb742d7"],

