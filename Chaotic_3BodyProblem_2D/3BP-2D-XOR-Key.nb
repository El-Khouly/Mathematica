Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"GenerateSBoxesFromStreamOLD", "[", 
     RowBox[{"bitstream_List", ",", "boxLength_Integer", ",", 
      RowBox[{"count_Integer", ":", "3"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "bitsPerEntry", ",", "totalBits", ",", "chunks", ",", "makeSBox", ",", 
        "sboxes"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"Bits", " ", "needed", " ", "per", " ", "entry", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"e", ".", "g", ".", "5"}], " ", "bits", " ", "for", " ", 
           "32"}], "-", 
          RowBox[{"entry", " ", "S"}], "-", "box"}], ")"}]}], "*)"}], 
      RowBox[{
       RowBox[{"bitsPerEntry", "=", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"Log2", "[", "boxLength", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"totalBits", "=", 
        RowBox[{"boxLength", "*", "bitsPerEntry"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "bitstream", "]"}], "<", 
          RowBox[{"count", "*", "totalBits"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"$Failed", ",", "Module"}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Helper", ":", 
         RowBox[{
          RowBox[{"convert", " ", "bit", " ", "chunk", " ", "to", " ", "S"}], 
          "-", "box"}]}], "*)"}], 
       RowBox[{
        RowBox[{"makeSBox", "[", "bits_", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"partitioned", ",", "decimals", ",", "unique"}], "}"}], 
          ",", 
          RowBox[{
           RowBox[{"partitioned", "=", 
            RowBox[{"Partition", "[", 
             RowBox[{"bits", ",", "bitsPerEntry"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"decimals", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"FromDigits", "[", 
               RowBox[{"#", ",", "2"}], "]"}], "&"}], "/@", "partitioned"}]}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"unique", "=", 
            RowBox[{"DeleteDuplicates", "[", "decimals", "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "unique", "]"}], "==", "boxLength"}], 
             ",", "unique", ",", 
             RowBox[{"Join", "[", 
              RowBox[{"unique", ",", 
               RowBox[{"Complement", "[", 
                RowBox[{
                 RowBox[{"Range", "[", 
                  RowBox[{"0", ",", 
                   RowBox[{"boxLength", "-", "1"}]}], "]"}], ",", "unique"}], 
                "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Slice", " ", "stream", " ", "into", " ", "chunks", " ", "and", " ", 
          "generate", " ", "S"}], "-", "boxes"}], "*)"}], 
       RowBox[{"chunks", "=", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"bitstream", ",", "totalBits"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{";;", "count"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sboxes", "=", 
        RowBox[{"makeSBox", "/@", "chunks"}]}], ";", "\[IndentingNewLine]", 
       "sboxes"}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GenerateSBoxesFromStream", "[", 
     RowBox[{"bitstream_List", ",", "boxLength_Integer", ",", 
      RowBox[{"count_Integer", ":", "3"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "perm", ",", 
        RowBox[{"pos", "=", "1"}], ",", "w", ",", "draw", ",", "j", ",", 
        RowBox[{"sboxes", "=", 
         RowBox[{"{", "}"}]}], ",", "k"}], "}"}], ",", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Ceiling", "[", 
         RowBox[{"Log2", "[", "boxLength", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"perm", "=", 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", 
             RowBox[{"boxLength", "-", "1"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Fisher", "-", 
             RowBox[{"Yates", ":", 
              RowBox[{
              "every", " ", "entry", " ", "is", " ", "placed", " ", "by", " ",
                "the", " ", "stream"}]}]}], ",", 
            RowBox[{"no", " ", "filler"}]}], "*)"}], 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"w", "=", 
              RowBox[{
               RowBox[{"Ceiling", "[", 
                RowBox[{"Log2", "[", "i", "]"}], "]"}], "+", "8"}]}], ";", 
             RowBox[{"(*", 
              RowBox[{
              "extra", " ", "bits", " ", "keep", " ", "the", " ", "modulo", 
               " ", "bias", " ", "negligible"}], "*)"}], 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"pos", "+", "w", "-", "1"}], ">", 
                RowBox[{"Length", "[", "bitstream", "]"}]}], ",", 
               RowBox[{"Return", "[", 
                RowBox[{"$Failed", ",", "Module"}], "]"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"draw", "=", 
              RowBox[{"FromDigits", "[", 
               RowBox[{
                RowBox[{"Take", "[", 
                 RowBox[{"bitstream", ",", 
                  RowBox[{"{", 
                   RowBox[{"pos", ",", 
                    RowBox[{"pos", "+", "w", "-", "1"}]}], "}"}]}], "]"}], 
                ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"pos", "+=", "w"}], ";", "\[IndentingNewLine]", 
             RowBox[{"j", "=", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{"draw", ",", "i"}], "]"}], "+", "1"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"perm", "[", 
               RowBox[{"[", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "j"}], "}"}], "]"}], "]"}], "=", 
              RowBox[{"perm", "[", 
               RowBox[{"[", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "i"}], "}"}], "]"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "boxLength", ",", "2", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"sboxes", ",", "perm"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "count"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "sboxes"}]}], "]"}]}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9662395558581676`*^9, 3.9662395917954125`*^9}, {
  3.9662396677648215`*^9, 3.9662396844071717`*^9}, {3.9662425854264402`*^9, 
  3.966242585751455*^9}, {3.968859345185811*^9, 3.9688593481891403`*^9}, {
  3.970713912513898*^9, 3.9707139143397284`*^9}, {3.9958045381860056`*^9, 
  3.9958045474441853`*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"a73756fe-3a9d-4ab4-b441-a5028f7bf9c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"EvalSbox", "[", "sbox_", "]"}], ":=", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sboxBitCount", " ", "=", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"2", ",", 
         RowBox[{"Length", "[", "sbox", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sboxBitsLists", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"IntegerDigits", "[", 
          RowBox[{
           RowBox[{"sbox", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", "2", ",", "sboxBitCount"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "sbox", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sboxBitLvlsList", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"sboxBitsLists", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "j", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "sbox", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "sboxBitCount"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"NaturalBasis", "[", "s_", "]"}], ":=", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"u", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"1", ",", "1"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"Nest", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ArrayFlatten", "[", 
             RowBox[{"#", "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"1", "\[Rule]", "u"}], ",", 
                RowBox[{
                 RowBox[{"-", "1"}], "\[Rule]", 
                 RowBox[{"-", "u"}]}]}], "}"}]}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"{", "1", "}"}], "}"}], ",", "s"}], "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"walshM", " ", "=", " ", 
       RowBox[{"NaturalBasis", "[", "sboxBitCount", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nonLin", " ", "=", " ", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "[", "sboxBitLvlsList", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{"nonLin", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"nonLin", ",", 
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"(", 
              RowBox[{"sboxBitCount", "-", "1"}], ")"}]}], "-", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Drop", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"sboxBitLvlsList", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ".", "walshM"}], ",", "1"}],
                "]"}], "]"}], "]"}]}]}], "]"}]}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"nonLin", " ", "=", " ", 
       RowBox[{"TextString", "[", "nonLin", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<Nonlinearity = \>\"", ",", "nonLin"}], "]"}], "]"}], 
        ";"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"SACRes2D", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "sboxBitCount"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "sboxBitCount"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"calBitVal", "[", 
        RowBox[{"m_", ",", "n_", ",", "testVal_"}], "]"}], ":=", 
       RowBox[{"BitAnd", "[", 
        RowBox[{
         RowBox[{"IntegerPart", "[", 
          RowBox[{"testVal", "/", 
           RowBox[{"(", 
            RowBox[{"2", "^", "n"}], ")"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"m", "=", "0"}], ",", 
        RowBox[{"m", "<", "sboxBitCount"}], ",", 
        RowBox[{"m", "++"}], ",", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "0"}], ",", 
          RowBox[{"i", "\[LessEqual]", 
           RowBox[{
            RowBox[{"Length", "[", "sbox", "]"}], "-", "1"}]}], ",", 
          RowBox[{"i", "++"}], ",", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"n", "=", "0"}], ",", 
            RowBox[{"n", "<", "sboxBitCount"}], ",", 
            RowBox[{"n", "++"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"SACRes2D", "[", 
               RowBox[{"[", 
                RowBox[{"m", "+", "1"}], "]"}], "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"n", "+", "1"}], "]"}], "]"}], "+=", 
             RowBox[{"calBitVal", "[", 
              RowBox[{"m", ",", "n", ",", 
               RowBox[{"BitXor", "[", 
                RowBox[{
                 RowBox[{"sbox", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"sbox", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"BitXor", "[", 
                    RowBox[{"i", ",", 
                    RowBox[{"2", "^", "m"}]}], "]"}], "+", "1"}], "]"}], 
                  "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"SAC", " ", "=", " ", 
       RowBox[{"TextString", "[", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Total", "[", 
           RowBox[{"SACRes2D", "/", 
            RowBox[{"(", 
             RowBox[{"2", "^", "sboxBitCount"}], ")"}]}], "]"}], "]"}], "/", 
         RowBox[{"sboxBitCount", "^", "2"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<SAC = \>\"", ",", " ", "SAC"}], "]"}], ";"}]}], "*)"}],
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"BIC", " ", "=", " ", 
       RowBox[{"TextString", "[", 
        RowBox[{
         RowBox[{"2", "^", 
          RowBox[{"(", 
           RowBox[{"sboxBitCount", "-", "1"}], ")"}]}], "-", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"(", 
              RowBox[{"sboxBitCount", "-", "1"}], ")"}]}], "-", 
            RowBox[{"Flatten", "[", "SACRes2D", "]"}]}], "]"}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<BIC = \>\"", ",", " ", "BIC"}], "]"}], "]"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"LAP", " ", "=", " ", 
       RowBox[{"TextString", "[", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Flatten", "[", "SACRes2D", "]"}], "/", 
             RowBox[{"2", "^", 
              RowBox[{"(", "sboxBitCount", ")"}]}]}], ")"}], "-", "0.5"}], 
          "]"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<LAP = \>\"", ",", " ", "LAP"}], "]"}], "]"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"DifList2D", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"(", 
            RowBox[{"2", "^", "sboxBitCount"}], ")"}]}], "}"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "1"}], ",", 
        RowBox[{"i", "<=", 
         RowBox[{"Length", "[", "sbox", "]"}]}], ",", 
        RowBox[{"i", "++"}], ",", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"j", "=", "1"}], ",", 
          RowBox[{"j", "<=", 
           RowBox[{"Length", "[", "sbox", "]"}]}], ",", 
          RowBox[{"j", "++"}], ",", 
          RowBox[{
           RowBox[{"DifList2D", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+=", 
           RowBox[{"(", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"sbox", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "-", 
              RowBox[{"sbox", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ")"}], ")"}]}]}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"DAP", " ", "=", " ", 
       RowBox[{"TextString", "[", 
        RowBox[{"1", "/", 
         RowBox[{"Mean", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"DifList2D", "/", 
            RowBox[{"2", "^", 
             RowBox[{"(", "sboxBitCount", ")"}]}]}], "]"}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"\"\<DAP = \>\"", ",", " ", "DAP"}], "]"}], "]"}], ";"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<nonLin\>\"", " ", "->", "nonLin"}], ",", " ", 
         RowBox[{"\"\<SAC\>\"", " ", "->", " ", "SAC"}], ",", " ", 
         RowBox[{"\"\<BIC\>\"", "->", "BIC"}], ",", " ", 
         RowBox[{"\"\<LAP\>\"", "->", " ", "LAP"}], ",", " ", 
         RowBox[{"\"\<DAP\>\"", "->", " ", "DAP"}]}], "}"}], "]"}], ";"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", ")"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Test", " ", "on", " ", "ASCON", " ", "S"}], "-", "box"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"ASCONsbox", "=", 
     RowBox[{"{", 
      RowBox[{
      "4", ",", "11", ",", "31", ",", "20", ",", "26", ",", "21", ",", "9", 
       ",", "2", ",", "27", ",", "5", ",", "8", ",", "18", ",", "29", ",", 
