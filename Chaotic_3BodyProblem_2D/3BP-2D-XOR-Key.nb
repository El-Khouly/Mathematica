Cell[BoxData["\<\"  SAC    -> Ideal = 0.5 (avalanche). Values near 0.5 are \
desirable.\"\>"], "Print",
 CellChangeTimes->{3.9707244765185304`*^9, 3.9707245073417745`*^9, 
  3.9707245780694733`*^9, 3.9707263424447327`*^9, 3.9755165523552303`*^9},
 CellLabel->
  "During evaluation of \
In[99]:=",ExpressionUUID->"23f32817-978e-422d-9112-0e3220cd3a36"],

Cell[BoxData["\<\"  BIC    -> (mean |corr| between output bits) : Lower is \
better (0 = perfect independence).\"\>"], "Print",
 CellChangeTimes->{3.9707244765185304`*^9, 3.9707245073417745`*^9, 
  3.9707245780694733`*^9, 3.9707263424447327`*^9, 3.9755165523573084`*^9},
 CellLabel->
  "During evaluation of \
In[99]:=",ExpressionUUID->"26848d89-4464-4ee2-809d-1467923284e6"],

Cell[BoxData["\<\"  LAP    -> Lower is better. (LAP = max |LAT| / 2^n, \
normalized; smaller bias is better).\"\>"], "Print",
 CellChangeTimes->{3.9707244765185304`*^9, 3.9707245073417745`*^9, 
  3.9707245780694733`*^9, 3.9707263424447327`*^9, 3.975516552360177*^9},
 CellLabel->
  "During evaluation of \
In[99]:=",ExpressionUUID->"5f24858d-200d-470a-a5db-8c6c59ec6ce9"],

Cell[BoxData["\<\"  DAP    -> Lower is better. (DAP = max entry of the DDT / \
2^n, probability; smaller is better).\"\>"], "Print",
 CellChangeTimes->{3.9707244765185304`*^9, 3.9707245073417745`*^9, 
  3.9707245780694733`*^9, 3.9707263424447327`*^9, 3.975516552362215*^9},
