  RowBox[{
   RowBox[{
    RowBox[{"seedA", "=", "105"}], ";", 
    RowBox[{"seedB", "=", "121"}], ";", 
    RowBox[{"tBurn", "=", "1"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"time1", ",", "key1"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"generateKeyWithPlot", "[", 
       RowBox[{"seedA", ",", "tBurn"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"time2", ",", "key2"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"generateKeyWithPlot", "[", 
       RowBox[{"seedB", ",", "tBurn"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"len", "=", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Length", "[", "key1", "]"}], ",", 
       RowBox[{"Length", "[", "key2", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"key", "=", 
     RowBox[{"BitXor", "[", 
      RowBox[{
       RowBox[{"key1", "[", 
        RowBox[{"[", 
         RowBox[{";;", "len"}], "]"}], "]"}], ",", 
       RowBox[{"key2", "[", 
        RowBox[{"[", 
         RowBox[{";;", "len"}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Seed \>\"", ",", "seedA", ",", "\"\< timing: \>\"", ",", "time1", 
      ",", "\"\< seconds\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Seed \>\"", ",", "seedB", ",", "\"\< timing: \>\"", ",", "time2", 
      ",", "\"\< seconds\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<XOR key length: \>\"", ",", "len"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<XOR key counts: \>\"", ",", 
      RowBox[{"Counts", "[", "key", "]"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Export", " ", "as", " ", "ASCII", " ", 
     RowBox[{"0", "/", "1"}], " ", "for", " ", "NIST", " ", 
     RowBox[{"STS", "--"}], " ", "each", " ", "key", " ", "alone", " ", "and",
      " ", "the", " ", "XOR"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"\"\<key_\>\"", "<>", 
       RowBox[{"ToString", "[", "seedA", "]"}], "<>", "\"\<.txt\>\""}], ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"ToString", "/@", "key1"}], "]"}], ",", "\"\<Text\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"\"\<key_\>\"", "<>", 
       RowBox[{"ToString", "[", "seedB", "]"}], "<>", "\"\<.txt\>\""}], ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"ToString", "/@", "key2"}], "]"}], ",", "\"\<Text\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"\"\<key_xor.txt\>\"", ",", 
      RowBox[{"StringJoin", "[", 
       RowBox[{"ToString", "/@", "key"}], "]"}], ",", "\"\<Text\>\""}], "]"}],
     ";"}]}]}]], "Input",
