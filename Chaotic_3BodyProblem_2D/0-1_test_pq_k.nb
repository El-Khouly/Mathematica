Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", "1."}]}], " ", 
    RowBox[{
     RowBox[{"input", "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"len", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"N", "@", 
      RowBox[{"RandomInteger", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", "len"}], "]"}]}]}], ";"}], 
   "        ", 
   RowBox[{"(*", 
    RowBox[{"swap", " ", "in", " ", "your", " ", "own", " ", "series"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"--", "2."}]}], " ", "p"}], "-", 
     RowBox[{"q", " ", 
      RowBox[{
       RowBox[{"trajectory", "--"}], "--"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pqPath", "[", 
     RowBox[{"v_List", ",", "c_"}], "]"}], ":=", 
    RowBox[{"Transpose", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", "#", "]"}], ",", 
         RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], "@", 
      RowBox[{"Accumulate", "[", 
       RowBox[{"v", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{"I", " ", "c", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "v", "]"}], "]"}]}], "]"}]}], "]"}]}], 
     "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c", "=", "1.2"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"pqPath", "[", 
      RowBox[{"x", ",", "c"}], "]"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"Thickness", "[", "0.001", "]"}]}], "}"}]}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"Axes", "->", "False"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", 
        RowBox[{"Thickness", "[", "0.002", "]"}], ",", 
        RowBox[{"FontSize", "->", "12"}]}], "]"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", 
         RowBox[{"\"\<p\>\"", ",", "Italic", ",", "14"}], "]"}], ",", 
        RowBox[{"Style", "[", 
         RowBox[{"\"\<q\>\"", ",", "Italic", ",", "14"}], "]"}]}], "}"}]}], 
     ",", 
     RowBox[{"ImageSize", "->", "600"}], ",", 
     RowBox[{"PlotRangePadding", "->", 
      RowBox[{"Scaled", "[", "0.05", "]"}]}]}], "]"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", "3."}]}], " ", 
     RowBox[{
      RowBox[{"K", "--"}], "--"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K01", "[", 
     RowBox[{"v_List", ",", "cc_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "z", ",", "phiMean", ",", "nMax", ",", "M", ",", "Dc", ",", 
        "nn"}], "}"}], ",", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"z", "=", 
        RowBox[{"Accumulate", "[", 
         RowBox[{"v", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", "cc", " ", 
            RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"phiMean", "=", 
        RowBox[{"Mean", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nMax", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"n", "/", "10"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"nn", "=", 
        RowBox[{"Range", "[", "nMax", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"M", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Mean", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Drop", "[", 
               RowBox[{"z", ",", "k"}], "]"}], "-", 
              RowBox[{"Drop", "[", 
               RowBox[{"z", ",", 
                RowBox[{"-", "k"}]}], "]"}]}], "]"}], "^", "2"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "nMax"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Dc", "=", 
        RowBox[{"M", "-", 
         RowBox[{
          RowBox[{"phiMean", "^", "2"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Cos", "[", 
              RowBox[{"nn", " ", "cc"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             RowBox[{"Cos", "[", "cc", "]"}]}], ")"}]}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Correlation", "[", 
        RowBox[{
         RowBox[{"N", "[", "nn", "]"}], ",", "Dc"}], "]"}]}]}], "]"}]}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cs", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "5"}], ",", 
         RowBox[{"4", " ", 
          RowBox[{"Pi", "/", "5"}]}]}], "}"}], ",", "100"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Ks", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"K01", "[", 
        RowBox[{"x", ",", "#"}], "]"}], "&"}], "/@", "cs"}]}], ";"}], "\n", 
   RowBox[{"kStat", "=", 
    RowBox[{"Median", "[", "Ks", "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Histogram", "[", 
    RowBox[{"Ks", ",", "Automatic", ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<median K = \>\"", ",", "kStat"}], "}"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0014950416355143`*^9, 4.001495050063242*^9}, {
  4.0014952033899217`*^9, 4.0014952316598215`*^9}},
 CellLabel->
  "In[161]:=",ExpressionUUID->"e532110e-091b-4176-83b1-34995f71a61a"],

