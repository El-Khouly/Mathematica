Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"--", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"data", "--"}], "--"}], "--"}], "--"}], "--"}]}]}]}]}]}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "5000", " ", "points", " ", "is", " ", "the", " ", "right", " ", "scale", 
     " ", "for", " ", "this", " ", "test"}], ";", 
    RowBox[{"100000", " ", "is", " ", "not"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xs", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Standardize", "[", 
       RowBox[{"Take", "[", 
        RowBox[{"key", ",", "50000"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "p"}]}]}]}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"q", "--"}], "--"}], "--"}], "--"}], "--"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pq", "[", 
      RowBox[{"x_List", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "x", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"x", "*", 
           RowBox[{"Cos", "[", 
            RowBox[{"c", "*", 
             RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"Accumulate", "[", 
          RowBox[{"x", "*", 
           RowBox[{"Sin", "[", 
            RowBox[{"c", "*", 
             RowBox[{"Range", "[", "n", "]"}]}], "]"}]}], "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "pq"}]}]}]}]}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"plot", "--"}], "--"}], "--"}], "--"}], "--"}]}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pqPlot", "[", 
      RowBox[{"x_List", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", "q"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "q"}], "}"}], "=", 
         RowBox[{"pq", "[", 
          RowBox[{"x", ",", "c"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"p", ",", "q"}], "}"}], "]"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Blue", ",", 
             RowBox[{"Thickness", "[", "0.001", "]"}]}], "}"}]}], ",", 
          RowBox[{"AspectRatio", "->", "1"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"FrameStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", 
             RowBox[{"Thickness", "[", "0.002", "]"}], ",", 
             RowBox[{"FontSize", "->", "12"}]}], "]"}]}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"\"\<p\>\"", ",", "Italic", ",", "14"}], "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{"\"\<q\>\"", ",", "Italic", ",", "14"}], "]"}]}], 
            "}"}]}], ",", 
          RowBox[{"ImageSize", "->", "600"}], ",", 
          RowBox[{"PlotRangePadding", "->", 
           RowBox[{"Scaled", "[", "0.05", "]"}]}], ",", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"Row", "[", 
            RowBox[{"{", 
             RowBox[{"\"\<c = \>\"", ",", "c"}], "}"}], "]"}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"pqPlot", "[", 
    RowBox[{"xs", ",", "0.6"}], "]"}], "\n", 
   RowBox[{"pqPlot", "[", 
    RowBox[{"xs", ",", "1.4"}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", "K"}]}]}]}]}], " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"statistic", "--"}], "--"}], "--"}], "--"}], "--"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"K01", "[", 
      RowBox[{"x_List", ",", "c_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "x", "]"}]}], ",", "p", ",", "q", ",", 
         "nMax", ",", "M"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"p", ",", "q"}], "}"}], "=", 
         RowBox[{"pq", "[", 
          RowBox[{"x", ",", "c"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nMax", "=", 
         RowBox[{"Floor", "[", 
          RowBox[{"n", "/", "10"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"vectorised", ":", 
          RowBox[{
          "Drop", " ", "replaces", " ", "the", " ", "inner", " ", "loop"}]}], 
         "*)"}], 
        RowBox[{"M", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Drop", "[", 
                 RowBox[{"p", ",", "k"}], "]"}], "-", 
                RowBox[{"Drop", "[", 
                 RowBox[{"p", ",", 
                  RowBox[{"-", "k"}]}], "]"}]}], ")"}], "^", "2"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Drop", "[", 
                 RowBox[{"q", ",", "k"}], "]"}], "-", 
                RowBox[{"Drop", "[", 
                 RowBox[{"q", ",", 
                  RowBox[{"-", "k"}]}], "]"}]}], ")"}], "^", "2"}]}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "nMax"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Correlation", "[", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"Range", "[", "nMax", "]"}], "]"}], ",", 
          RowBox[{"N", "[", "M", "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cs", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Pi", "/", "5"}], ",", 
         RowBox[{"4", " ", 
          RowBox[{"Pi", "/", "5"}]}]}], "}"}], ",", "100"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Ks", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"K01", "[", 
        RowBox[{"xs", ",", "#"}], "]"}], "&"}], "/@", "cs"}]}], ";"}], "\n", 
   RowBox[{"K", "=", 
    RowBox[{"Median", "[", "Ks", "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"Histogram", "[", 
    RowBox[{"Ks", ",", "Automatic", ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<median K = \>\"", ",", 
         RowBox[{"NumberForm", "[", 
          RowBox[{"K", ",", "4"}], "]"}]}], "}"}], "]"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<K\>\"", ",", "\"\<count\>\""}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"ImageSize", "->", "500"}]}], "]"}]}]}]], "Input",
