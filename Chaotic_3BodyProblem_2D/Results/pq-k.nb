Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", "read"}]}]}]}]}], " ", "the", " ", "bitstream", " ", 
    "back", " ", "from", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"input00", "--"}], "--"}], "--"}], "--"}], "--"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"bits", "=", 
     RowBox[{"ToExpression", "/@", 
      RowBox[{"Characters", "[", 
       RowBox[{"Import", "[", 
        RowBox[{"\"\<input00\>\"", ",", "\"\<Text\>\""}], "]"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{"Length", "[", "bits", "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"xs", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Standardize", "[", 
       RowBox[{"Take", "[", 
        RowBox[{"bits", ",", "50000"}], "]"}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
