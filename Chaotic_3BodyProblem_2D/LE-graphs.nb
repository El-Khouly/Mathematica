\>\"", "]"}], ",", 
        RowBox[{
        "Print", "[", 
         "\"\<\\n\:2717 System appears regular (no positive exponent)\>\"", 
         "]"}]}], "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
