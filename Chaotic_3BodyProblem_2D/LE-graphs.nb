        RowBox[{"12", ",", 
         RowBox[{"Length", "[", "finalLCEs", "]"}]}], "]"}]}], ",", 
      RowBox[{"i", "++"}], ",", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<\[Lambda]\>\"", ",", "i", ",", "\"\< = \>\"", ",", 
        RowBox[{"finalLCEs", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
