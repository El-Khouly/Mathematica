      "F", ",", "DPhi", ",", "x", ",", "Phi", ",", "x0", ",", "Phi0", ",", 
       RowBox[{"{", 
        RowBox[{"Ttest", ",", "stepsize"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
