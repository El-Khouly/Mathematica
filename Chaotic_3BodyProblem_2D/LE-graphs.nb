   RowBox[{"(*", 
    RowBox[{"8.4", " ", "Symplectic", " ", "symmetry", " ", 
     RowBox[{"check", ":", 
      RowBox[{"\[Lambda]_i", "+", 
       RowBox[{"\[Lambda]_", 
        RowBox[{"{", 
         RowBox[{"n", "+", "1", "-", "i"}], "}"}], " ", "should", " ", 
        RowBox[{"be", "~", "0"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
