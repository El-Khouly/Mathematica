   RowBox[{"(*", 
    RowBox[{"Compute", " ", "initial", " ", "energy"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"r12init", "=", 
     RowBox[{"Norm", "[", 
      RowBox[{"pos2", "-", "pos1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"r13init", "=", 
