             "\"\<  \[Lambda]\:2081 = \>\"", ",", 
             RowBox[{"currentLCEs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             "\"\<  \[Lambda]\:2082 = \>\"", ",", 
             RowBox[{"currentLCEs", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "\"\<  Max = \>\"", ",", 
             RowBox[{"Max", "[", "currentLCEs", "]"}]}], "]"}]}], "]"}], 
         ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "K"}], "}"}]}], "]"}], ",", 
      RowBox[{"ProgressIndicator", "[", 
       RowBox[{"i", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "K"}], "}"}]}], "]"}]}], "]"}], ";"}], 
