      RowBox[{"Count", "[", 
       RowBox[{"finalLCEs", ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", ">", "0.001"}]}]}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
