      "="}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"finalLCEs", "=", 
     RowBox[{"Last", "[", "lambdaHistory", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
