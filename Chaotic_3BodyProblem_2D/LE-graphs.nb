         RowBox[{"Print", "[", 
          RowBox[{"\"\<Pair \>\"", ",", "i", ",", "\"\<: \>\"", ",", 
           RowBox[{"sympPairs", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Average deviation from 0: \>\"", ",", 
         RowBox[{"Mean", "[", 
          RowBox[{"Abs", "[", "sympPairs", "]"}], "]"}]}], "]"}], ";"}]}], 
     "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "\[IndentingNewLine]", 
