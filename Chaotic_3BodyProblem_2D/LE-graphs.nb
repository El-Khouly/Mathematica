      RowBox[{"Max", "[", "finalLCEs", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of positive exponents: \>\"", ",", 
      RowBox[{"Count", "[", 
       RowBox[{"finalLCEs", ",", 
        RowBox[{"x_", "/;", 
         RowBox[{"x", ">", "0.001"}]}]}], "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
