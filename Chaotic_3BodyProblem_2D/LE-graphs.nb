   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== Convergence Plot (First 6 Exponents) ===\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Length", "[", "lambdaHistory", "]"}], ">", "0"}], ",", 
