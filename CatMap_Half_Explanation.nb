Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"RunCatMap", "[", 
     RowBox[{
     "img_Image", ",", "n_Integer", ",", "k_Integer", ",", "a_Integer", ",", 
      "b_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "data", ",", "coords", ",", "mat", ",", "newCoords", ",", "permuted"}],
        "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"Get", " ", "pixel", " ", "array"}], "*)"}], 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"ImageData", "[", 
         RowBox[{"img", ",", "\"\<Byte\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Arnold", " ", "Cat", " ", "Map", " ", "matrix"}], "*)"}], 
       RowBox[{"mat", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "a"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", 
            RowBox[{
             RowBox[{"a", " ", "b"}], "+", "1"}]}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Apply", " ", "k", " ", "iterations", " ", "modulo", " ", "n"}], 
        "*)"}], 
       RowBox[{"newCoords", "=", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"mat", ".", 
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "0", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ",", "n"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Permute", " ", "pixels", " ", "according", " ", "to", " ", "new", 
         " ", "coordinates"}], "*)"}], 
       RowBox[{"permuted", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Dimensions", "[", "data", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"permuted", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              RowBox[{"newCoords", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"i", "+", "1"}], ",", 
                 RowBox[{"j", "+", "1"}], ",", "2"}], "]"}], "]"}], "+", 
              "1"}], ",", 
             RowBox[{
              RowBox[{"newCoords", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"i", "+", "1"}], ",", 
                 RowBox[{"j", "+", "1"}], ",", "1"}], "]"}], "]"}], "+", 
              "1"}]}], "]"}], "]"}], "=", 
          RowBox[{"data", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"j", "+", "1"}], ",", 
             RowBox[{"i", "+", "1"}]}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Image", "[", "permuted", "]"}]}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"imgQuarter", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kQuarter", ",", "1", ",", "1"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"imgMid", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kMid", ",", "1", ",", "1"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"imgThreeQuarters", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kThreeQuarters", ",", "1", ",", "1"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "img", ",", "imgQuarter", ",", "imgMid", ",", "imgThreeQuarters"}], 
      "}"}], ",", 
     RowBox[{"ImageSize", "->", "800"}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Original | 1/4 Period | 1/2 Period | 3/4 Period\>\""}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9913630427395134`*^9, 3.9913630436798134`*^9}},
 CellLabel->"In[37]:=",ExpressionUUID->"72dd26f9-2b44-4934-8b60-ce9aa3b5a6d7"],

