Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"RunCatMap", "[", 
     RowBox[{
     "img_Image", ",", "n_Integer", ",", "k_Integer", ",", "a_Integer", ",", 
      "b_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", ",", "permuted", ",", "mat", ",", "coords"}], "}"}], 
      ",", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"ImageData", "[", 
         RowBox[{"img", ",", "\"\<Byte\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"permuted", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Dimensions", "[", "data", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Arnold", " ", "Cat", " ", "Map", " ", "matrix"}], "*)"}], 
       RowBox[{"mat", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "a"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", 
            RowBox[{
             RowBox[{"a", " ", "b"}], "+", "1"}]}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{"(*", 
         RowBox[{
         "Apply", " ", "k", " ", "iterations", " ", "to", " ", "each", " ", 
          "pixel", " ", "coordinate"}], "*)"}], 
        RowBox[{
         RowBox[{
          RowBox[{"coords", "=", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"Nest", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"mat", ".", "#"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "j"}], "}"}], ",", "k"}], "]"}], ",", "n"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"permuted", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"coords", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "+", "1"}], ",", 
              RowBox[{
               RowBox[{"coords", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "+", "1"}]}], "]"}], "]"}], 
           "=", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"j", "+", "1"}], ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Image", "[", "permuted", "]"}]}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Now", " ", "run", " ", "at", " ", "quarter"}], ",", "half", ",", 
     RowBox[{"three", "-", "quarter"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imgQuarter", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kQuarter", ",", "1", ",", "1"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"imgMid", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kMid", ",", "1", ",", "1"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"imgThreeQuarters", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kThreeQuarters", ",", "1", ",", "1"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "img", ",", "imgQuarter", ",", "imgMid", ",", "imgThreeQuarters"}], 
      "}"}], ",", 
     RowBox[{"ImageSize", "->", "800"}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Original | 1/4 Period | 1/2 Period | 3/4 Period\>\""}]}], "]"}], 
   "\n", "\n"}]}]], "Input",
 CellChangeTimes->{{3.991363073177102*^9, 3.991363074206006*^9}, 
   3.9913631367881365`*^9},
 CellLabel->"In[47]:=",ExpressionUUID->"b3d77dc7-bfe2-41a6-afb2-f077dcb15428"],

