Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "=="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "DEFINITIONS"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "=="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"RunCatMap", "[", 
     RowBox[{
     "img_Image", ",", "n_Integer", ",", "k_Integer", ",", "a_Integer", ",", 
      "b_Integer"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"data", ",", "permuted", ",", "mat", ",", "coords"}], "}"}], 
      ",", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"ImageData", "[", 
         RowBox[{"img", ",", "\"\<Byte\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"permuted", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Dimensions", "[", "data", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"mat", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "a"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", 
            RowBox[{
             RowBox[{"a", " ", "b"}], "+", "1"}]}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"coords", "=", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"Nest", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"mat", ".", "#"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "j"}], "}"}], ",", "k"}], "]"}], ",", "n"}],
             "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"permuted", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{
               RowBox[{"coords", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "+", "1"}], ",", 
              RowBox[{
               RowBox[{"coords", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "+", "1"}]}], "]"}], "]"}], 
           "=", 
           RowBox[{"data", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"j", "+", "1"}], ",", 
              RowBox[{"i", "+", "1"}]}], "]"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "0", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Image", "[", 
        RowBox[{"permuted", ",", "\"\<Byte\>\""}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ArnoldPeriod", "[", "N_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"k", "=", "1"}], ",", 
        RowBox[{"A", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"MatrixPower", "[", 
             RowBox[{"A", ",", "k"}], "]"}], ",", "N"}], "]"}], "!=", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
         RowBox[{"k", "++"}]}], "]"}], ";", "k"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "=="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "LOAD", " ", "AND", " ", "PREPARE", " ", "THE", " ", "IMAGE"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "1024"}], ";", 
    RowBox[{"a", "=", "1"}], ";", 
    RowBox[{"b", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"img", "=", 
     RowBox[{"ExampleData", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<TestImage\>\"", ",", "\"\<Mandrill\>\""}], "}"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"img", "=", 
     RowBox[{"ImageResize", "[", 
      RowBox[{"img", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "=="}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "COMPUTE", " ", "PERIOD", " ", "AND", " ", "KEY", " ", "FRAME",
      " ", "COUNTS"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P", "=", 
     RowBox[{"ArnoldPeriod", "[", "n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kQuarter", "=", 
     RowBox[{"Round", "[", 
      RowBox[{"P", "/", "4"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kMid", "=", 
     RowBox[{"P", "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kThreeQuarters", "=", 
     RowBox[{"Round", "[", 
      RowBox[{"3", " ", 
       RowBox[{"P", "/", "4"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Period = \>\"", ",", "P"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Quarter = \>\"", ",", "kQuarter", ",", "\"\<,  Mid = \>\"", ",", 
      "kMid", ",", "\"\<,  3/4 = \>\"", ",", "kThreeQuarters"}], "]"}], ";"}],
    "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "GENERATE", " ", "THE", " ", "TRANSFORMED", " ", "IMAGES"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"imgQuarter", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kQuarter", ",", "a", ",", "b"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"imgMid", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kMid", ",", "a", ",", "b"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"imgThreeQuarters", "=", 
     RowBox[{"RunCatMap", "[", 
      RowBox[{"img", ",", "n", ",", "kThreeQuarters", ",", "a", ",", "b"}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"5.", " ", "DISPLAY", " ", "ALL", " ", "FOUR", " ", "IMAGES"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "img", ",", "imgQuarter", ",", "imgMid", ",", "imgThreeQuarters"}], 
      "}"}], ",", 
     RowBox[{"ImageSize", "->", "800"}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Original | 1/4 Period | 1/2 Period | 3/4 Period\>\""}]}], 
    "]"}]}]}]], "Input",
