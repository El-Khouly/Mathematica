Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"YOUR", " ", "RunCatMap", " ", 
     RowBox[{"(", 
      RowBox[{"color", ",", "unchanged"}], ")"}]}], "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"RunCatMap", "[", 
     RowBox[{
     "image_", ",", "imageSize_", ",", "iterations_", ",", "a_", ",", "b_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "catMap", ",", "redChannel", ",", "greenChannel", ",", "blueChannel"}],
        "}"}], ",", 
      RowBox[{
       RowBox[{"catMap", "=", 
        RowBox[{"Compile", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"pic", ",", "_Integer", ",", "2"}], "}"}], "}"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"pic", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"x", "+", 
                  RowBox[{"a", "*", "y"}]}], ",", "imageSize", ",", "1"}], 
                "]"}], ",", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"b", "*", "x"}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "+", 
                    RowBox[{"a", "*", "b"}]}], ")"}], "*", "y"}]}], ",", 
                 "imageSize", ",", "1"}], "]"}]}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "imageSize"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", "imageSize"}], "}"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"redChannel", ",", "greenChannel", ",", "blueChannel"}], 
         "}"}], "=", 
        RowBox[{"ColorSeparate", "[", "image", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"redChannel", "=", 
        RowBox[{"Image", "[", 
         RowBox[{
          RowBox[{"Nest", "[", 
           RowBox[{"catMap", ",", 
            RowBox[{"ImageData", "[", 
             RowBox[{"redChannel", ",", "\"\<Byte\>\""}], "]"}], ",", 
            "iterations"}], "]"}], ",", "\"\<Byte\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"greenChannel", "=", 
        RowBox[{"Image", "[", 
         RowBox[{
          RowBox[{"Nest", "[", 
           RowBox[{"catMap", ",", 
            RowBox[{"ImageData", "[", 
             RowBox[{"greenChannel", ",", "\"\<Byte\>\""}], "]"}], ",", 
            "iterations"}], "]"}], ",", "\"\<Byte\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"blueChannel", "=", 
        RowBox[{"Image", "[", 
         RowBox[{
          RowBox[{"Nest", "[", 
           RowBox[{"catMap", ",", 
            RowBox[{"ImageData", "[", 
             RowBox[{"blueChannel", ",", "\"\<Byte\>\""}], "]"}], ",", 
            "iterations"}], "]"}], ",", "\"\<Byte\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ColorCombine", "[", 
        RowBox[{"{", 
         RowBox[{"redChannel", ",", "greenChannel", ",", "blueChannel"}], 
         "}"}], "]"}]}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"PERIOD", " ", "COMPUTATION", " ", 
      RowBox[{"(", 
       RowBox[{"matrix", " ", "power", " ", "method"}], ")"}]}], "==="}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ArnoldPeriod", "[", "N_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"k", "=", "1"}], ",", 
        RowBox[{"A", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"MatrixPower", "[", 
             RowBox[{"A", ",", "k"}], "]"}], ",", "N"}], "]"}], "!=", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ",", 
         RowBox[{"k", "++"}]}], "]"}], ";", "k"}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"===", 
     RowBox[{"YOUR", " ", "MyMSSIM"}], "==="}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MyMSSIM", "[", 
      RowBox[{"img1raw_Image", ",", "img2raw_Image", ",", 
       RowBox[{"window_", ":", 
        RowBox[{"GaussianMatrix", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"11", "-", "1"}], ")"}], "/", "2"}], ",", 
              RowBox[{"{", "2", "}"}]}], "]"}], ",", "1.5"}], "}"}], ",", 
          RowBox[{"Method", "->", "\"\<Gaussian\>\""}]}], "]"}]}], ",", 
       RowBox[{"k1_", ":", "0.01"}], ",", 
       RowBox[{"k2_", ":", "0.03"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"f", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Sequence", "@@", 
                RowBox[{"ImageDimensions", "[", "img1raw", "]"}]}], "]"}], 
              "/", "256"}], "]"}]}], "]"}]}], ",", 
         RowBox[{"img1in", "=", 
          RowBox[{"ColorConvert", "[", 
           RowBox[{
            RowBox[{"Image", "[", 
             RowBox[{"img1raw", ",", "\"\<Real\>\""}], "]"}], ",", 
            "\"\<Grayscale\>\""}], "]"}]}], ",", 
         RowBox[{"img2in", "=", 
          RowBox[{"ColorConvert", "[", 
           RowBox[{
            RowBox[{"Image", "[", 
             RowBox[{"img2raw", ",", "\"\<Real\>\""}], "]"}], ",", 
            "\"\<Grayscale\>\""}], "]"}]}], ",", "mssimmap", ",", "mssim"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"f", ">", "1"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"img1in", ",", "img2in"}], "}"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"ImageCorrelate", "[", 
               RowBox[{
                RowBox[{"ImagePad", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"NestList", "[", 
                   RowBox[{"Reverse", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Floor", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"f", "-", "1"}], ")"}], "/", "2"}], "]"}], ",", 
                    RowBox[{"Ceiling", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"f", "-", "1"}], ")"}], "/", "2"}], "]"}]}], 
                    "}"}], ",", "1"}], "]"}], ",", "\"\<Reversed\>\""}], 
                 "]"}], ",", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{
                  RowBox[{"1.", "/", 
                   RowBox[{"Times", "[", 
                    RowBox[{"f", ",", "f"}], "]"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"f", ",", "f"}], "}"}]}], "]"}], ",", 
                RowBox[{"Padding", "->", "None"}]}], "]"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{"img1in", ",", "img2in"}], "}"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"img1in", ",", "img2in"}], "}"}], "=", 
            RowBox[{
             RowBox[{
              RowBox[{"ImageTake", "[", 
               RowBox[{"#", ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"-", "1"}], ",", "f"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"-", "1"}], ",", "f"}], "}"}]}], "]"}], "&"}], "/@", 
             RowBox[{"{", 
              RowBox[{"img1in", ",", "img2in"}], "}"}]}]}], ";"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"mssimmap", "=", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"img1", ",", "img2"}], "}"}], ",", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"mu1", ",", "mu2"}], "}"}], ",", 
               RowBox[{
                RowBox[{"Function", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"mu1mu1", ",", "mu2mu2", ",", "mu1mu2"}], "}"}], 
                  ",", 
                  RowBox[{"ImageApply", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#1", "/", "#2"}], "&"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ImageMultiply", "[", 
                    RowBox[{
                    RowBox[{"ImageAdd", "[", 
                    RowBox[{
                    RowBox[{"ImageMultiply", "[", 
                    RowBox[{"mu1mu2", ",", "2."}], "]"}], ",", 
                    RowBox[{"k1", "^", "2"}]}], "]"}], ",", 
                    RowBox[{"ImageAdd", "[", 
                    RowBox[{
                    RowBox[{"ImageMultiply", "[", 
                    RowBox[{
                    RowBox[{"ImageSubtract", "[", 
                    RowBox[{
                    RowBox[{"ImageCorrelate", "[", 
                    RowBox[{
                    RowBox[{"ImageMultiply", "[", 
                    RowBox[{"img1", ",", "img2"}], "]"}], ",", "window", ",", 
                    RowBox[{"Padding", "->", "None"}]}], "]"}], ",", 
                    "mu1mu2"}], "]"}], ",", "2."}], "]"}], ",", 
                    RowBox[{"k2", "^", "2"}]}], "]"}]}], "]"}], ",", 
                    RowBox[{"ImageMultiply", "[", 
                    RowBox[{
                    RowBox[{"ImageAdd", "[", 
                    RowBox[{
                    RowBox[{"ImageAdd", "[", 
                    RowBox[{"mu1mu1", ",", "mu2mu2"}], "]"}], ",", 
                    RowBox[{"k1", "^", "2"}]}], "]"}], ",", 
                    RowBox[{"ImageAdd", "[", 
                    RowBox[{
                    RowBox[{"ImageAdd", "[", 
                    RowBox[{
                    RowBox[{"ImageSubtract", "[", 
                    RowBox[{
                    RowBox[{"ImageCorrelate", "[", 
                    RowBox[{
                    RowBox[{"ImageMultiply", "[", 
                    RowBox[{"img1", ",", "img1"}], "]"}], ",", "window", ",", 
                    RowBox[{"Padding", "->", "None"}]}], "]"}], ",", 
                    "mu1mu1"}], "]"}], ",", 
                    RowBox[{"ImageSubtract", "[", 
                    RowBox[{
                    RowBox[{"ImageCorrelate", "[", 
                    RowBox[{
                    RowBox[{"ImageMultiply", "[", 
                    RowBox[{"img2", ",", "img2"}], "]"}], ",", "window", ",", 
                    RowBox[{"Padding", "->", "None"}]}], "]"}], ",", 
                    "mu2mu2"}], "]"}]}], "]"}], ",", 
                    RowBox[{"k2", "^", "2"}]}], "]"}]}], "]"}]}], "}"}]}], 
                   "]"}]}], "]"}], "[", 
                RowBox[{
                 RowBox[{"ImageMultiply", "[", 
                  RowBox[{"mu1", ",", "mu1"}], "]"}], ",", 
                 RowBox[{"ImageMultiply", "[", 
                  RowBox[{"mu2", ",", "mu2"}], "]"}], ",", 
                 RowBox[{"ImageMultiply", "[", 
                  RowBox[{"mu1", ",", "mu2"}], "]"}]}], "]"}]}], "]"}], "[", 
             RowBox[{
              RowBox[{"ImageCorrelate", "[", 
               RowBox[{"img1", ",", "window", ",", 
                RowBox[{"Padding", "->", "None"}]}], "]"}], ",", 
              RowBox[{"ImageCorrelate", "[", 
               RowBox[{"img2", ",", "window", ",", 
                RowBox[{"Padding", "->", "None"}]}], "]"}]}], "]"}]}], "]"}], 
          "[", 
          RowBox[{"img1in", ",", "img2in"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mssim", "=", 
         RowBox[{"ImageMeasurements", "[", 
          RowBox[{"mssimmap", ",", "\"\<Mean\>\""}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "mssim", "]"}], ";"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9858374812767057`*^9, 3.9858374823341665`*^9}, {
  3.9913712139922733`*^9, 3.9913712145831604`*^9}},
