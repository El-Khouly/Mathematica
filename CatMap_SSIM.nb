    "Print", "[", "\"\<-----------|------------|----------|-------------\>\"",
      "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Helper", " ", "to", " ", "format", " ", "numbers", " ", "as", " ", 
     "strings", " ", "with", " ", "fixed", " ", "width"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fmtNum", "[", 
      RowBox[{"num_", ",", "width_", ",", "prec_"}], "]"}], ":=", 
     RowBox[{"StringPadLeft", "[", 
      RowBox[{
       RowBox[{"ToString", "[", 
        RowBox[{"NumberForm", "[", 
         RowBox[{"num", ",", 
          RowBox[{"{", 
           RowBox[{"prec", ",", "prec"}], "}"}]}], "]"}], "]"}], ",", 
       "width"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fmtInt", "[", 
      RowBox[{"int_", ",", "width_"}], "]"}], ":=", 
     RowBox[{"StringPadLeft", "[", 
      RowBox[{
       RowBox[{"ToString", "[", "int", "]"}], ",", "width"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"\"\<Mandrill   | \>\"", ",", 
       RowBox[{"fmtInt", "[", 
        RowBox[{"mKopt", ",", "10"}], "]"}], ",", "\"\< | \>\"", ",", 
       RowBox[{"fmtNum", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"mKopt", "/", "P"}], "]"}], ",", "8", ",", "3"}], "]"}], 
       ",", "\"\< | \>\"", ",", 
       RowBox[{"fmtNum", "[", 
        RowBox[{
         RowBox[{"Min", "[", "mSsims", "]"}], ",", "10", ",", "4"}], "]"}]}], 
      "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"StringJoin", "[", 
      RowBox[{"\"\<Peppers    | \>\"", ",", 
       RowBox[{"fmtInt", "[", 
        RowBox[{"pKopt", ",", "10"}], "]"}], ",", "\"\< | \>\"", ",", 
       RowBox[{"fmtNum", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"pKopt", "/", "P"}], "]"}], ",", "8", ",", "3"}], "]"}], 
       ",", "\"\< | \>\"", ",", 
       RowBox[{"fmtNum", "[", 
        RowBox[{
         RowBox[{"Min", "[", "pSsims", "]"}], ",", "10", ",", "4"}], "]"}]}], 
      "]"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"StringRepeat", "[", 
      RowBox[{"\"\<-\>\"", ",", "60"}], "]"}], "]"}], ";"}]}]}]], "Input",
