Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"===", 
    RowBox[{"MAIN", " ", "ANALYSIS"}], "==="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "256"}], ";", 
    RowBox[{"a", "=", "1"}], ";", 
    RowBox[{"b", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"imgMandrill", "=", 
     RowBox[{"ExampleData", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<TestImage\>\"", ",", "\"\<Mandrill\>\""}], "}"}], "]"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"imgPeppers", "=", 
     RowBox[{"ExampleData", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<TestImage\>\"", ",", "\"\<Peppers\>\""}], "}"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"imgMandrill", "=", 
     RowBox[{"ImageResize", "[", 
      RowBox[{"imgMandrill", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"imgPeppers", "=", 
     RowBox[{"ImageResize", "[", 
      RowBox[{"imgPeppers", ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Images resized to \>\"", ",", "n", ",", "\"\<\[Times]\>\"", ",", 
      "n", ",", "\"\<.\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"P", "=", 
     RowBox[{"ArnoldPeriod", "[", "n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Period P = \>\"", ",", "P"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"step", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"1", ",", 
       RowBox[{"Floor", "[", 
        RowBox[{"P", "/", "80"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ks", "=", 
     RowBox[{"Sort", "[", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "1", "}"}], ",", 
         RowBox[{"Range", "[", 
          RowBox[{"2", ",", 
           RowBox[{"P", "-", "1"}], ",", "step"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Floor", "[", 
            RowBox[{"P", "/", "2"}], "]"}], ",", 
           RowBox[{"P", "-", "1"}]}], "}"}]}], "]"}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Testing \>\"", ",", 
      RowBox[{"Length", "[", "ks", "]"}], ",", 
      "\"\< iteration values per image.\>\""}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"analyseImage", "[", 
      RowBox[{"img_", ",", "name_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "ssims", ",", "bestIdx", ",", "kOpt", ",", "imgWeak", ",", "imgOpt", 
         ",", "plot"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<\\n--- \>\"", ",", "name", ",", "\"\< ---\>\""}], "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"ssims", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"transformed", "=", 
             RowBox[{"RunCatMap", "[", 
              RowBox[{"img", ",", "n", ",", "k", ",", "a", ",", "b"}], 
              "]"}]}], ";", 
            RowBox[{"MyMSSIM", "[", 
             RowBox[{"img", ",", "transformed"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "ks"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"bestIdx", "=", 
         RowBox[{
          RowBox[{"Ordering", "[", 
           RowBox[{"ssims", ",", "1"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"kOpt", "=", 
         RowBox[{"ks", "[", 
          RowBox[{"[", "bestIdx", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{
         "\"\<Optimal k* = \>\"", ",", "kOpt", ",", "\"\< (k*/P = \>\"", ",", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"N", "[", 
             RowBox[{"kOpt", "/", "P"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "3"}], "}"}]}], "]"}], ",", "\"\<)\>\""}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Minimum MSSIM = \>\"", ",", 
          RowBox[{"NumberForm", "[", 
           RowBox[{
            RowBox[{"ssims", "[", 
             RowBox[{"[", "bestIdx", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"6", ",", "4"}], "}"}]}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"imgWeak", "=", 
         RowBox[{"RunCatMap", "[", 
          RowBox[{"img", ",", "n", ",", "1", ",", "a", ",", "b"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"imgOpt", "=", 
         RowBox[{"RunCatMap", "[", 
          RowBox[{"img", ",", "n", ",", "kOpt", ",", "a", ",", "b"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"plot", "=", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"ks", ",", "ssims"}], "}"}], "]"}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"name", "<>", "\"\< - MSSIM vs iterations\>\""}]}], ",", 
           RowBox[{"AxesLabel", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<k\>\"", ",", "\"\<MSSIM\>\""}], "}"}]}], ",", 
           RowBox[{"Epilog", "->", 
            RowBox[{"{", 
             RowBox[{"Red", ",", 
              RowBox[{"PointSize", "[", "Large", "]"}], ",", 
              RowBox[{"Point", "[", 
               RowBox[{"{", 
                RowBox[{"kOpt", ",", 
                 RowBox[{"ssims", "[", 
                  RowBox[{"[", "bestIdx", "]"}], "]"}]}], "}"}], "]"}]}], 
             "}"}]}], ",", 
           RowBox[{"GridLines", "->", "Automatic"}], ",", " ", 
           RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
         "plot", ",", "imgWeak", ",", "imgOpt", ",", "ks", ",", "ssims", ",", 
          "kOpt", ",", "name"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "mPlot", ",", "mWeak", ",", "mOpt", ",", "mKs", ",", "mSsims", ",", 
       "mKopt", ",", "mName"}], "}"}], "=", 
     RowBox[{"analyseImage", "[", 
      RowBox[{"imgMandrill", ",", "\"\<Mandrill\>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
