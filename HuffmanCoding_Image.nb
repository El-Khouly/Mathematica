Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "=="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Huffman", " ", "Compression", " ", "for", " ", "Images", " ", 
    RowBox[{"(", "Mathematica", ")"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "=="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"buildHuffmanTree", "[", "counts_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nodes", ",", "left", ",", "right", ",", "newFreq"}], "}"}], 
      ",", 
      RowBox[{
       RowBox[{"nodes", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#2", ",", "#1"}], "}"}], "&"}], "@@@", 
         RowBox[{"Normal", "[", "counts", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "nodes", "]"}], ">", "1"}], ",", 
         RowBox[{
          RowBox[{"nodes", "=", 
           RowBox[{"SortBy", "[", 
            RowBox[{"nodes", ",", "First"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"leftFreq", ",", "leftNode"}], "}"}], "=", 
           RowBox[{"First", "[", "nodes", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"rightFreq", ",", "rightNode"}], "}"}], "=", 
           RowBox[{"nodes", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"nodes", "=", 
           RowBox[{"Rest", "[", 
            RowBox[{"Rest", "[", "nodes", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"newFreq", "=", 
           RowBox[{"leftFreq", "+", "rightFreq"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"nodes", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"nodes", ",", 
             RowBox[{"{", 
              RowBox[{"newFreq", ",", 
               RowBox[{"{", 
                RowBox[{"leftNode", ",", "rightNode"}], "}"}]}], "}"}]}], 
            "]"}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"nodes", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "2"}], "]"}], "]"}]}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"generateCodes", "[", "tree_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"codes", "=", 
         RowBox[{"<|", "|>"}]}], ",", "traverse"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"traverse", "[", 
         RowBox[{"node_", ",", "prefix_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"AtomQ", "[", "node", "]"}], ",", 
          RowBox[{
           RowBox[{"codes", "[", "node", "]"}], "=", "prefix"}], ",", 
          RowBox[{
           RowBox[{"traverse", "[", 
            RowBox[{
             RowBox[{"node", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"prefix", "<>", "\"\<0\>\""}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"traverse", "[", 
            RowBox[{
             RowBox[{"node", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"prefix", "<>", "\"\<1\>\""}]}], "]"}], ";"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"traverse", "[", 
        RowBox[{"tree", ",", "\"\<\>\""}], "]"}], ";", "\[IndentingNewLine]", 
       "codes"}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"compressImage", "[", "img_Image", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "data", ",", "counts", ",", "tree", ",", "codes", ",", "bitStream"}], 
       "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"Ensure", " ", "grayscale"}], "*)"}], 
      RowBox[{
       RowBox[{"imgGray", "=", 
        RowBox[{"ColorConvert", "[", 
         RowBox[{"img", ",", "\"\<Grayscale\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"ImageData", "[", 
          RowBox[{"imgGray", ",", "\"\<Byte\>\""}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"counts", "=", 
        RowBox[{"Counts", "[", "data", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"tree", "=", 
        RowBox[{"buildHuffmanTree", "[", "counts", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"codes", "=", 
        RowBox[{"generateCodes", "[", "tree", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bitStream", "=", 
        RowBox[{"StringJoin", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"codes", "[", "#", "]"}], "&"}], "/@", "data"}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Tree\>\"", "->", "tree"}], ",", 
         RowBox[{"\"\<Dictionary\>\"", "->", "codes"}], ",", 
         RowBox[{"\"\<BitStream\>\"", "->", "bitStream"}], ",", 
         RowBox[{"\"\<Dimensions\>\"", "->", 
          RowBox[{"ImageDimensions", "[", "imgGray", "]"}]}], ",", 
         RowBox[{"\"\<OriginalSizeBytes\>\"", "->", 
          RowBox[{"Length", "[", "data", "]"}]}]}], "   ", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"each", " ", "pixel"}], "=", 
          RowBox[{"1", " ", "byte"}]}], "*)"}], "|>"}]}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"reconstructImage", "[", "comp_Association", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "tree", ",", "bitStream", ",", "dims", ",", "pos", ",", "node", ",", 
        "reconstructedList", ",", "bit"}], "}"}], ",", 
      RowBox[{
       RowBox[{"tree", "=", 
        RowBox[{"comp", "[", "\"\<Tree\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bitStream", "=", 
        RowBox[{"comp", "[", "\"\<BitStream\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dims", "=", 
        RowBox[{"comp", "[", "\"\<Dimensions\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pos", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"reconstructedList", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"pos", "<=", 
          RowBox[{"StringLength", "[", "bitStream", "]"}]}], ",", 
         RowBox[{
          RowBox[{"node", "=", "tree"}], ";", "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"AtomQ", "[", "node", "]"}]}], ",", 
            RowBox[{
             RowBox[{"bit", "=", 
              RowBox[{"StringTake", "[", 
               RowBox[{"bitStream", ",", 
                RowBox[{"{", 
                 RowBox[{"pos", ",", "pos"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"pos", "++"}], ";", "\[IndentingNewLine]", 
             RowBox[{"node", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"bit", "==", "\"\<0\>\""}], ",", 
                RowBox[{"node", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"node", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";"}]}], "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"reconstructedList", ",", "node"}], "]"}], ";"}]}], "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Image", "[", 
        RowBox[{
         RowBox[{"Partition", "[", 
          RowBox[{"reconstructedList", ",", 
           RowBox[{"dims", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ",", "\"\<Byte\>\""}], 
        "]"}]}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"compressionInfo", "[", "comp_Association", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "dictionarySize", ",", "streamSizeBytes", ",", "totalCompressedBytes", 
        ",", "ratio"}], "}"}], ",", 
      RowBox[{
       RowBox[{"dictionarySize", "=", 
        RowBox[{"Total", "[", 
         RowBox[{"ByteCount", "/@", 
          RowBox[{"Values", "[", 
           RowBox[{"comp", "[", "\"\<Dictionary\>\"", "]"}], "]"}]}], "]"}]}],
        ";", "\[IndentingNewLine]", 
       RowBox[{"streamSizeBytes", "=", 
        RowBox[{
         RowBox[{"StringLength", "[", 
          RowBox[{"comp", "[", "\"\<BitStream\>\"", "]"}], "]"}], "/", 
         "8.0"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"bits", "->", "bytes"}], "*)"}], 
       RowBox[{"totalCompressedBytes", "=", 
        RowBox[{"dictionarySize", "+", "streamSizeBytes"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ratio", "=", 
        RowBox[{
         RowBox[{"comp", "[", "\"\<OriginalSizeBytes\>\"", "]"}], "/", 
         "totalCompressedBytes"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<OriginalBytes\>\"", "->", 
          RowBox[{"comp", "[", "\"\<OriginalSizeBytes\>\"", "]"}]}], ",", 
         RowBox[{"\"\<DictionaryBytes\>\"", "->", "dictionarySize"}], ",", 
         RowBox[{"\"\<BitStreamBytes\>\"", "->", "streamSizeBytes"}], ",", 
         RowBox[{"\"\<CompressedBytes\>\"", "->", "totalCompressedBytes"}], 
         ",", 
         RowBox[{"\"\<CompressionRatio\>\"", "->", "ratio"}]}], "|>"}]}]}], 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
