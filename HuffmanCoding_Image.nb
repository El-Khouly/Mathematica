                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{"--", 
                    RowBox[{
                    "--", "-"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
]}]}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"img", "=", 
     RowBox[{"ImageResize", "[", 
      RowBox[{
       RowBox[{"ExampleData", "[", 
        RowBox[{"{", 
         RowBox[{"\"\<TestImage\>\"", ",", "\"\<Mandrill\>\""}], "}"}], "]"}],
        ",", 
       RowBox[{"{", 
        RowBox[{"512", ",", "512"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Original (grayscale) image: \>\"", ",", 
      RowBox[{"ColorConvert", "[", 
       RowBox[{"img", ",", "\"\<Grayscale\>\""}], "]"}]}], "]"}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Time", " ", "the", " ", "whole", " ", "process"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"time", ",", 
       RowBox[{"{", 
        RowBox[{"comp", ",", "reconstructed"}], "}"}]}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{
       RowBox[{"comp", "=", 
        RowBox[{"compressImage", "[", "img", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"reconstructed", "=", 
        RowBox[{"reconstructImage", "[", "comp", "]"}]}], ";"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Total time (seconds): \>\"", ",", "time"}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Compute", " ", "sizes"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"info", "=", 
     RowBox[{"compressionInfo", "[", "comp", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Original image size: \>\"", ",", 
      RowBox[{"info", "[", "\"\<OriginalBytes\>\"", "]"}], ",", 
      "\"\< bytes\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Compressed size: \>\"", ",", 
      RowBox[{"info", "[", "\"\<CompressedBytes\>\"", "]"}], ",", 
      "\"\< bytes\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<  (Dictionary: \>\"", ",", 
      RowBox[{"info", "[", "\"\<DictionaryBytes\>\"", "]"}], ",", 
      "\"\< bytes, BitStream: \>\"", ",", 
      RowBox[{"info", "[", "\"\<BitStreamBytes\>\"", "]"}], ",", 
      "\"\< bytes)\>\""}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Compression ratio: \>\"", ",", 
      RowBox[{"info", "[", "\"\<CompressionRatio\>\"", "]"}]}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Byte\:2011exact", " ", "verification"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"origData", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ImageData", "[", 
       RowBox[{
        RowBox[{"ColorConvert", "[", 
         RowBox[{"img", ",", "\"\<Grayscale\>\""}], "]"}], ",", 
        "\"\<Byte\>\""}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"reconData", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"ImageData", "[", 
       RowBox[{"reconstructed", ",", "\"\<Byte\>\""}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Bytes match exactly? \>\"", ",", 
      RowBox[{"origData", "===", "reconData"}]}], "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Visual", " ", "comparison"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"GraphicsRow", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ColorConvert", "[", 
        RowBox[{"img", ",", "\"\<Grayscale\>\""}], "]"}], ",", 
       "reconstructed"}], "}"}], ",", 
     RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}]}]], "Input",
